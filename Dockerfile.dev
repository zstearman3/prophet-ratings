# syntax=docker/dockerfile:1
ARG RUBY_VERSION=4.0.5
FROM ruby:${RUBY_VERSION}-slim

WORKDIR /rails
ENV RAILS_ENV=development \
    BUNDLE_WITHOUT=charts \
    BUNDLE_JOBS=2 \
    BUNDLE_APP_CONFIG=/usr/local/bundle \
    BUNDLE_FROZEN=true

RUN apt-get update -qq && apt-get install --no-install-recommends -y \
    build-essential git libpq-dev libyaml-dev nodejs npm pkg-config \
    postgresql-client python3 python3-numpy && \
    npm install --global yarn@1.22.19 && \
    rm -rf /var/lib/apt/lists/*

# SQL schema dumps must use the same major version as the local/test database.
COPY --from=postgres:15-trixie /usr/lib/postgresql/15/bin/pg_dump /usr/local/bin/pg_dump

COPY Gemfile Gemfile.lock ./
RUN bundle install

# Source is bind-mounted by Compose. No production asset compilation or data setup.
CMD ["bash"]
