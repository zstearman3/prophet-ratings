<h2>Review <%= @object.year %> season memberships</h2>
<p><%= link_to 'Back to offseason setup', main_app.admin_offseason_setup_path(season_id: @object.id), class: 'text-blue-700 underline' %></p>
<% established = @object.current? || @object.rating_outputs? %>
<p>Fetch and inspect proposals for any season. Full participation/date approval is available before preseason publication.</p>
<% if established %>
  <div class="alert alert-info">This season has established outputs. You can inspect proposals and correct selected conference memberships.
    Participation, dates and published ratings remain protected.</div>
<% end %>
<% if @review_error %>
  <div class="alert alert-danger" role="alert"><%= @review_error %></div>
<% end %>
<% if @object.participation_review.present? %>
  <div class="alert alert-success">Stored participation review by <%= @object.participation_review['reviewed_by'] %>.
    Approved <%= @object.participation_review['reviewed_at'] %>.
    <% if @object.participation_review.dig('membership_source', 'source_year') %>
      Source year <%= @object.participation_review.dig('membership_source', 'source_year') %> for target <%= @object.year %>.
    <% end %>
    Refresh only if another review is needed.</div>
<% end %>
<%= form_tag rails_admin.review_memberships_path(model_name: 'season', id: @object.id, operation: 'refresh'), method: :post, id: 'membership-refresh-form', data: { turbo: false }, class: 'd-inline-block' do %>
  <%= button_tag "Fetch proposals from #{ENV.fetch('GAME_SYNC_PROVIDER', 'sports_reference') == 'cbbd' ? 'CBBD' : 'Sports Reference'}", name: nil, class: 'btn btn-secondary' %>
<% end %>
<%= form_tag rails_admin.review_memberships_path(model_name: 'season', id: @object.id, operation: 'refresh_previous'), method: :post, id: 'membership-previous-form', data: { turbo: false }, class: 'd-inline-block' do %>
  <%= button_tag "Start from previous season (#{@object.year - 1})", name: nil, class: 'btn btn-secondary', disabled: @object.year <= 1 %>
<% end %>
<p>The previous-season option explicitly fetches that year's selected source directory or standings. It never silently substitutes older data.</p>
<% proposal = @object.membership_proposal %>
<% if proposal.present? %>
  <% carried_forward = proposal['source_year'].present? && proposal['source_year'] != proposal['target_year'] %>
  <% if carried_forward %>
    <div class="alert alert-warning">Target <%= proposal.fetch('target_year') %> proposal based on <%= proposal.fetch('source_year') %> memberships.
      Carried-forward rows are unverified for the target year. Check realignment, arrivals and departures before approving.</div>
  <% end %>
  <p>Retained provider: <%= proposal.fetch('provider', 'sports_reference') %>.</p>
  <% if proposal['provider'] == 'cbbd' %>
    <div class="alert alert-warning">CBBD season-filtered affiliations and a matching season echo do not prove complete Division I coverage or settled future realignment. Independently verify the complete target-year roster. Missing schools or conference metadata never establish departure or independence.</div>
    <p>CBBD school IDs: <%= proposal.fetch('source_rows').map { |row| row.fetch('team_external_id') }.join(', ') %>. Private capture references are retained with this proposal.</p>
  <% end %>
  <p>Source year: <%= proposal.fetch('source_year', @object.year) %> · Target year: <%= @object.year %>.</p>
  <p>Source: <%= link_to proposal.fetch('source_url'), proposal.fetch('source_url'), target: '_blank', rel: 'noopener' %>
    · Captured <%= proposal.fetch('captured_at') %> · <%= proposal.fetch('source_rows').size %> source schools.</p>
  <% if proposal.fetch('issues').any? %>
    <div class="alert alert-warning">
      <p>Map unmatched conferences below. Import or finish school setup below. Resolve ambiguous identities in RailsAdmin, then fetch again. Full roster approval is blocked until they resolve. Selected conference-only corrections remain available.</p>
      <ul><% proposal.fetch('issues').each do |issue| %><li><%= issue %></li><% end %></ul>
    </div>
  <% end %>
  <%= render partial: 'school_imports', locals: { proposal: proposal } %>
  <%= render partial: 'conference_mappings', locals: { proposal: proposal } %>
  <% default_operation = established ? 'correct_memberships' : 'approve' %>
  <p>To save conference corrections, select the checkbox beside each school, choose its membership and check the scope confirmation below. Manual decisions are recorded as “Manual Review”.</p>
  <%= form_tag rails_admin.review_memberships_path(model_name: 'season', id: @object.id, operation: default_operation), method: :post, id: 'membership-review-form', data: { turbo: false } do %>
    <%= hidden_field_tag 'review[proposal_key]', @review_values.fetch('proposal_key', SeasonMembershipReview.new(@object).proposal_key) %>
    <p><%= check_box_tag 'select_all_corrections', '1', false, id: 'select-all-corrections', onchange: "this.form.querySelectorAll('.membership-correction-selection').forEach((checkbox) => { checkbox.checked = this.checked; });" %>
      <%= label_tag 'select-all-corrections', 'Select all schools for correction (including collapsed rows)' %></p>
    <% conferences = Conference.order(:name).pluck(:name, :id) %>
    <% changes, unchanged = proposal.fetch('rows').partition { |row| row.fetch('changed') || row.fetch('choice') == 'unresolved' } %>
    <%= render partial: 'membership_rows', locals: { rows: changes, conferences: conferences, established: established } %>
    <details>
      <summary><%= unchanged.size %> unchanged proposed memberships (expand to review or select corrections)</summary>
      <%= render partial: 'membership_rows', locals: { rows: unchanged, conferences: conferences, established: established } %>
    </details>
    <% unless established %>
      <div class="mb-3">
      <%= label_tag 'review_start_date', 'Season start' %>
      <%= date_field_tag 'review[start_date]', @review_values.fetch('start_date', @object.start_date.iso8601), required: true %>
      <%= label_tag 'review_end_date', 'Season end' %>
      <%= date_field_tag 'review[end_date]', @review_values.fetch('end_date', @object.end_date.iso8601), required: true %>
    </div>
    <% end %>
    <% if carried_forward %>
      <p><%= check_box_tag 'review[confirm_target_year]', '1', @review_values['confirm_target_year'] == '1' %>
        <%= label_tag 'review_confirm_target_year', "I verified the rows being approved against target-year #{@object.year} evidence, including carried-forward memberships." %></p>
    <% end %>
    <% if proposal['provider'] == 'cbbd' && !established %>
      <p><%= check_box_tag 'review[confirm_source_coverage]', '1', @review_values['confirm_source_coverage'] == '1' %>
        <%= label_tag 'review_confirm_source_coverage', 'I independently verified complete target-year roster/source coverage, including arrivals, departures and realignment.' %></p>
    <% end %>
    <% unless established %>
      <p>Absence does not prove departure from Division I. Choose N/A only after checking. Full approval saves all displayed decisions and dates;
        it does not publish ratings or activate the season.</p>
    <% end %>
    <% unless established %>
      <%= button_tag 'Approve memberships, participation and dates', name: nil, formaction: rails_admin.review_memberships_path(model_name: 'season', id: @object.id, operation: 'approve'), class: 'btn btn-primary', disabled: proposal.fetch('issues').any? %>
    <% end %>
    <hr>
    <p>For conference-only corrections, select schools in the table. Changes are scoped to this year and preserve surrounding membership ranges.
      Missing boundary seasons must be prepared first. Other unresolved schools do not prevent selected corrections.</p>
    <p><%= check_box_tag 'review[confirm_memberships_only]', '1', @review_values['confirm_memberships_only'] == '1' %>
      <%= label_tag 'review_confirm_memberships_only', 'I am correcting conference metadata only. Participation, dates, ratings, predictions and stored game conference flags will not be recalculated.' %></p>
    <%= button_tag 'Apply selected conference corrections only', name: nil, formaction: rails_admin.review_memberships_path(model_name: 'season', id: @object.id, operation: 'correct_memberships'), class: 'btn btn-secondary' %>
  <% end %>
<% end %>
<% if @object.membership_corrections.any? %>
  <% correction = @object.membership_corrections.last %>
  <p>Last conference-only correction: <%= correction.fetch('reviewed_at') %> by <%= correction.fetch('reviewed_by') %>,
    <%= correction.fetch('decisions').size %> selected schools, source year <%= correction.dig('source', 'source_year') %> for target <%= correction.fetch('target_year') %>. Evidence: <%= correction.fetch('evidence') %></p>
<% end %>
