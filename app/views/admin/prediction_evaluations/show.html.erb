<section class="space-y-6 pb-12">
  <h1 class="text-3xl font-bold">Prediction evaluation</h1>
  <p>Errors are predicted minus actual: positive means overprediction. Pace is possessions per 40 minutes; scores include overtime.</p>
  <%= form_tag admin_prediction_evaluation_path, method: :get, data: { turbo: false }, class: 'flex flex-wrap gap-4 items-end' do %>
    <div><%= label_tag :season_id, 'Season' %><br><%= select_tag :season_id, options_from_collection_for_select(@page[:seasons], :id, :year, @page[:season]&.id) %></div>
    <div><%= label_tag :model_id, 'Baseline model' %><br><%= select_tag :model_id, options_from_collection_for_select(@page[:models], :id, :name, @page[:model]&.id) %></div>
    <div><%= label_tag :comparison_id, 'Compare model (optional)' %><br><%= select_tag :comparison_id, options_from_collection_for_select(@page[:models], :id, :name, params[:comparison_id]), include_blank: 'None' %></div>
    <div><%= label_tag :mode, 'Forecast type' %><br><%= select_tag :mode, options_for_select([['Verified pregame', 'pregame'], ['Legacy exploration — unverified', 'legacy_unverified'], ['Postgame reconstructions', 'reconstruction']], params[:mode] || 'pregame') %></div>
    <div><%= label_tag :from, 'From (blank = season start)' %><br><%= date_field_tag :from, params[:from] %></div>
    <div><%= label_tag :to, 'Through (blank = season end)' %><br><%= date_field_tag :to, params[:to] %></div>
    <%= submit_tag 'Evaluate predictions', class: 'rounded bg-blue-700 px-4 py-2 text-white' %>
  <% end %>
  <% if @page[:metrics] %>
    <% coverage = @page[:metrics].fetch(:coverage) %>
    <% if coverage[:mode] != 'pregame' %>
      <p class="rounded border border-amber-500 bg-amber-50 p-4 font-semibold">Exploratory results only. These forecasts are not verified pregame predictions and cannot establish live predictive performance.</p>
    <% end %>
    <p><strong><%= @page[:model].name %></strong> · <%= @page[:dates].first %> through <%= @page[:dates].last %> (Eastern game dates).</p>
    <p><%= coverage[:selected] %> selected forecasts; <%= coverage[:evaluated] %> evaluated; <%= coverage[:excluded_invalid] %> excluded for participant alignment or invalid outcomes. One forecast per game/model.</p>
    <% coverage.fetch(:excluded_by_reason).each do |reason, count| %>
      <p><%= reason.humanize %>: <%= count %> excluded.</p>
    <% end %>
    <p>Available forecast records before selection: <%= coverage[:available_by_kind].map { |kind, count| "#{kind}: #{count}" }.join(', ').presence || 'none' %>.</p>
    <p class="text-sm">Actuals use current finalized box scores. Corrections can change this report. Historical reconstructions are evaluated separately; legacy uncertainty is omitted.</p>
    <% if @page[:comparison] %>
      <h2 class="text-xl font-semibold">Common-game comparison</h2>
      <p><%= @page[:comparison][:games] %> games with valid outcomes in both models. Lower is better for all metrics below. These are descriptive differences, not evidence of statistical significance.</p>
      <table class="w-full text-left"><thead><tr><th>Metric</th><th><%= @page[:model].name %></th><th><%= @page[:comparison_model].name %></th></tr></thead><tbody>
        <% %i[margin_mae total_mae brier_score log_loss].each do |metric| %>
          <tr><th><%= metric.to_s.humanize %></th><td><%= @page[:comparison][:baseline][metric]&.then { |value| value.is_a?(Numeric) ? value.round(4) : value } || 'N/A' %></td><td><%= @page[:comparison][:candidate][metric]&.then { |value| value.is_a?(Numeric) ? value.round(4) : value } || 'N/A' %></td></tr>
        <% end %>
      </tbody></table>
    <% end %>
    <% if @page[:metrics][:games].zero? %>
      <p class="rounded bg-gray-100 p-4">No eligible predictions for this selection. Check the season, model, dates, and forecast type. No forecasts or backfills are generated by this page.</p>
    <% else %>
      <h2 class="text-xl font-semibold">Baseline scorecard</h2>
      <dl class="flex flex-wrap gap-8">
        <% %i[margin_mae total_mae brier_score log_loss].each do |metric| %>
          <div><dt><%= metric.to_s.humanize %></dt><dd class="text-xl font-semibold"><%= @page[:metrics][metric].is_a?(Numeric) ? @page[:metrics][metric].round(4) : @page[:metrics][metric] %></dd></div>
        <% end %>
        <div><dt>Winner accuracy</dt><dd><%= number_to_percentage(@page[:metrics].dig(:prediction_accuracy, :prediction_accuracy) * 100, precision: 1) %></dd></div>
      </dl>
      <h2 class="text-xl font-semibold">Residual diagnostics</h2>
      <table class="w-full text-left"><thead><tr><th>Outcome</th><th>Observations</th><th>MAE</th><th>RMSE</th><th>Bias</th><th>Sample SD</th></tr></thead><tbody>
        <% @page[:metrics][:residuals].each do |name, summary| %>
          <tr><th><%= { home: 'Home efficiency', away: 'Away efficiency' }.fetch(name, name.to_s.humanize) %></th><% %i[observations mae rmse bias sd].each do |key| %><td><%= summary[key]&.round(3) || 'N/A' %></td><% end %></tr>
        <% end %>
      </tbody></table>
      <% report = @page[:evaluator].report %>
      <%= render "factors", report: report %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div><h3>Predicted vs actual pace</h3><%= scatter_chart report.pace_pairs, xtitle: 'Predicted pace', ytitle: 'Actual pace', height: '300px' %></div>
        <div><h3>Pace error vs predicted pace</h3><%= scatter_chart report.pace_residual_pairs, xtitle: 'Predicted pace', ytitle: 'Predicted − actual', height: '300px' %></div>
        <% report.residuals.each do |name, values| %>
          <div><h3><%= name.to_s.humanize %> error distribution (n=<%= values.size %>)</h3><%= column_chart ProphetRatings::EvaluationReport.histogram(values), xtitle: 'Predicted − actual (bins of 2)', ytitle: 'Observations', height: '280px' %></div>
        <% end %>
        <div><h3>Standardized margin errors (n=<%= report.rows.count { |row| row[:margin_z] } %>)</h3><%= column_chart report.z_histogram, xtitle: '(Predicted − actual) / predicted SD', ytitle: 'Games', height: '280px' %></div>
        <div><h3>Win probability calibration</h3><%= scatter_chart [{ name: 'Observed', data: report.calibration.map { |bin| [bin[:mean_probability], bin[:observed_home_win_rate]] } }, { name: 'Ideal', data: [[0, 0], [0.25, 0.25], [0.5, 0.5], [0.75, 0.75], [1, 1]] }], xtitle: 'Mean predicted probability', ytitle: 'Observed home win rate', min: 0, max: 1, height: '300px' %></div>
      </div>
      <p>Calibration includes sparse bins; use the counts below when interpreting apparent deviations.</p>
      <table class="w-full text-left"><thead><tr><th>Probability bin</th><th>Games</th><th>Mean prediction</th><th>Observed win rate</th></tr></thead><tbody>
        <% report.calibration.each do |bin| %>
          <tr><td><%= bin[:lower].round(1) %>–<%= bin[:upper].round(1) %></td><td><%= bin[:games] %></td><td><%= bin[:mean_probability].round(3) %></td><td><%= bin[:observed_home_win_rate].round(3) %></td></tr>
        <% end %>
      </tbody></table>
      <h2 class="text-xl font-semibold">Team pace errors</h2>
      <p>The same game pace error is attributed to both teams; this is a diagnostic grouping, not an estimate of which team caused the error.</p>
      <%= link_to 'Download team pace CSV', admin_prediction_evaluation_path(request.query_parameters.merge(format: :csv)), class: 'text-blue-700 underline' %>
      <table class="w-full text-left"><thead><tr><th>Team</th><th>Games</th><th>Bias</th><th>Sample SD</th></tr></thead><tbody>
        <% report.team_residuals.each do |team| %>
          <tr><td><%= team[:school] %></td><td><%= team[:observations] %></td><td><%= team[:bias]&.round(3) || 'N/A' %></td><td><%= team[:sd]&.round(3) || 'N/A' %></td></tr>
        <% end %>
      </tbody></table>
    <% end %>
  <% else %>
    <p>Prepare a season and publish a model version before evaluating predictions.</p>
  <% end %>
</section>
