<% if @page[:draft_team_review] %>
  <%= render 'draft_team_review' %>
<% else %>
<section class="mx-auto max-w-6xl space-y-6 pb-12">
  <h1 class="text-3xl font-bold">Departure batch #<%= @batch.id %> · Target <%= @batch.season.year %></h1>
  <p><%= link_to 'Back to offseason setup', admin_offseason_setup_path(season_id: @batch.season_id), class: 'text-blue-700 underline' %> · <%= link_to 'All departure batches', admin_departure_batches_path(season_id: @batch.season_id), class: 'text-blue-700 underline' %> · <%= link_to 'Refresh status', admin_departure_batch_path(@batch), class: 'text-blue-700 underline' %></p>
  <% if notice %><p role="status" class="rounded bg-green-100 p-3"><%= notice %></p><% end %>
  <% if @page[:error] %><p role="alert" class="rounded bg-red-100 p-3"><%= @page[:error] %></p><% end %>
  <section class="rounded border p-5 space-y-3"><h2 class="text-2xl font-semibold"><%= departure_stage(@batch, @page[:attempt]) %></h2>
  <p><%= @batch.season.year - 1 %> NBA draft · college season ending <%= @batch.season.year - 1 %> · target season ending <%= @batch.season.year %></p>
  <% if @page[:attempt]&.status.in?(%w[queued running]) %><p>The background worker fetches five sources. Refresh status to check progress. No player decisions or publication are available until source coverage is reviewed.</p><% end %>
  <% if @page[:attempt]&.failure.present? %><p class="rounded bg-red-100 p-3"><%= @page[:attempt].failure %></p><% end %>
  <p>Batch: <%= @batch.status %>. Inputs only: publication does not calculate ratings or activate a season.</p>
  </section>
  <% if @batch.revision_id %><p>Published revision #<%= @batch.revision_id %> by <%= @batch.reviewed_by %> at <%= @batch.reviewed_at %>.</p><% end %>
  <% if @batch.predecessor_id %><p>Correction of <%= link_to "batch ##{@batch.predecessor_id}", admin_departure_batch_path(@batch.predecessor_id), class: 'text-blue-700 underline' %>: <%= @batch.correction_reason %></p><% end %>
  <% if @batch.status == 'draft' && @page[:attempt]&.status == 'running' %>
    <%= form_with url: acquire_admin_departure_batch_path(@batch), method: :post, data: { turbo: false }, class: 'rounded border p-4 space-y-3' do |form| %>
      <%= form.hidden_field :capture_only, value: '1' %>
      <p>If the worker was interrupted, close this attempt and queue a new bounded successor. Earlier bytes remain retained. An active worker will be prevented from replacing the closed evidence.</p>
      <%= form.check_box :close_interrupted, { required: true }, '1', '0' %><%= form.label :close_interrupted, 'I verified that this acquisition was interrupted' %>
      <%= form.submit 'Close interrupted attempt and retry', class: 'rounded border px-4 py-2 font-medium hover:bg-gray-100' %>
    <% end %>
  <% end %>
  <% editable = @batch.status == 'draft' && !@page[:attempt]&.status.in?(%w[queued running]) %>
  <% if editable && @batch.plan['provider'].nil? %>
    <p>Historical HTML evidence is retained for offline review and correction. Create a new CBBD batch for fresh acquisition.</p>
    <% if @page[:attempt]&.terminal? %>
      <details class="rounded border p-4"><summary class="cursor-pointer font-medium">Recover with saved HTML from permitted normal access</summary>
        <p>Upload unchanged original HTML, at most 5 MiB. Supply the actual original URL and capture metadata; never bypass access restrictions. This retains a successor and clears decisions.</p>
        <%= form_with url: recover_admin_departure_batch_path(@batch), scope: :recovery, multipart: true, data: { turbo: false }, class: 'mt-4 space-y-3' do |form| %>
          <%= form.label :source_id, 'Source to replace' %><%= form.select :source_id, @page[:attempt].plan.fetch('sources').map { |source| ["#{source['id']} · #{source['url']}", source['id']] }, {}, class: 'block w-full rounded border p-2' %>
          <% { url: 'Actual original URL', http_status: 'Actual HTTP status (200)', captured_at: 'Captured at (ISO 8601)', observed_at: 'Observed at (ISO 8601)', source_as_of: 'Source publication time (ISO 8601, if known)', source_as_of_reason: 'Reason publication time is unknown' }.each do |key, label| %><div><%= form.label key, label %><%= form.text_field key, class: 'block w-full rounded border p-2' %></div><% end %>
          <%= form.label :html, 'Original saved HTML' %><%= form.file_field :html, accept: '.html,text/html', required: true, class: 'block w-full rounded border p-2' %><%= form.submit 'Retain recovery attempt', class: 'rounded bg-prophet-indigo px-4 py-2 text-white' %>
        <% end %>
      </details>
    <% end %>
  <% end %>
  <% if editable && @page[:coverage] && @page[:attempt].manifest.present? %>
    <% if @page[:capture_only] || @page[:coverage_fields] %><%= render 'coverage' %><% else %><details class="rounded border p-4"><summary class="cursor-pointer font-medium">Revise source coverage without fetching again</summary><div class="mt-4"><%= render 'coverage' %></div></details><% end %>
  <% end %>
  <% if @page[:attempt]&.dataset.present? %>
  <section class="rounded border p-5 space-y-4" aria-labelledby="player-review-heading"><h2 id="player-review-heading" class="text-2xl font-semibold">3. Review players and publish</h2>
  <%= render 'production_warnings', warnings: @page[:report].fetch('production_warnings', []) %>
  <h3 class="text-xl font-semibold">Saved draft report</h3>
  <% @page[:report].fetch('errors').each do |error| %><p role="alert" class="rounded bg-red-100 p-3"><%= error %></p><% end %>
  <% @page[:report].fetch('gaps').each do |gap| %><p><%= gap %></p><% end %>
  <div class="overflow-x-auto rounded border"><table class="w-full text-left text-sm"><thead class="bg-gray-100"><tr><th class="p-3">Team</th><th class="p-3">Known points</th><th class="p-3">Team points</th><th class="p-3">Loss share</th><th class="p-3">Coverage</th></tr></thead><tbody>
    <% @page[:report].fetch('teams').each do |row| %><tr><td class="p-3"><%= @page[:teams_by_id].fetch(row['team_id']).school %></td><td class="p-3"><%= row['known_points_subtotal'] %></td><td class="p-3"><%= row['team_points'] %></td><td class="p-3"><%= row['loss_share'].nil? ? 'Unknown / partial' : row['loss_share'] %></td><td class="p-3"><span data-coverage-reason="<%= row['reason'] %>"><%= row['reason'].to_s.humanize %></span></td></tr><% end %>
  </tbody></table></div>
  <% if editable && @page[:attempt]&.dataset.present? %>
    <%= render 'decisions' %>
    <h2 class="text-xl font-semibold">Approve saved decisions</h2>
    <p>Approval uses only saved decisions above. Review every listed gap before acknowledging partial publication. Failed sources, conflicting evidence and invalid facts cannot be acknowledged away.</p>
    <%= form_with url: publish_admin_departure_batch_path(@batch), scope: :review, method: :patch, data: { turbo: false }, class: 'rounded border p-4 space-y-3' do |form| %>
      <%= form.hidden_field :review_key, value: @page[:review_key] %>
      <% if @page[:report].fetch('gaps').any? %><%= form.check_box :acknowledge_gaps %><%= form.label :acknowledge_gaps, 'I acknowledge each displayed coverage gap and unknown loss' %><% end %>
      <%= form.check_box :confirm %><%= form.label :confirm, 'I approve these saved departure decisions' %><%= form.submit 'Publish reviewed inputs', class: 'rounded bg-prophet-indigo px-4 py-2 font-medium text-white hover:bg-prophet-indigo/80' %>
    <% end %>
  <% end %>
  </section>
  <% end %>
  <% if editable && @batch.plan['provider'] == 'cbbd' %>
  <details class="rounded border p-4"><summary class="cursor-pointer font-medium">Fetch recovery and advanced preparation</summary><div class="mt-4 space-y-3">
    <% unless @page[:capture_only] %><details class="rounded border p-4"><summary class="cursor-pointer font-medium">Edit saved preparation (clears decisions)</summary><%= render 'preparation', preparation: @page[:preparation], season: @batch.season, destination: admin_departure_batch_path(@batch), verb: :patch %></details><% end %>
    <%= button_to 'Fetch sources again', acquire_admin_departure_batch_path(@batch), params: { capture_only: '1' }, class: 'rounded border px-4 py-2 font-medium hover:bg-gray-100' %>
    <p class="text-sm text-gray-600">A new fetch retains earlier evidence and requires fresh coverage and player review.</p>
  </div></details>
  <% end %>
  <%= render 'evidence' %>
  <% if @batch.status == 'published' %>
    <%= form_with url: correct_admin_departure_batch_path(@batch), method: :post, data: { turbo: false }, class: 'rounded border p-4 space-y-3' do |form| %><%= form.label :reason, 'Correction reason' %><%= form.text_field :reason, required: true, class: 'block w-full rounded border p-2' %><%= form.submit 'Start correction with retained evidence', class: 'rounded bg-prophet-indigo px-4 py-2 text-white' %><% end %>
  <% end %>
</section>
<% end %>
