<details data-source-details class="rounded border p-4"><summary class="cursor-pointer font-medium">Retained source evidence and history</summary>
  <p class="mt-3">Original response bytes remain private and downloadable. Source acquisition is never approval.</p>
  <% if @page[:source_attempt] %><p>Attempt #<%= @page[:source_attempt].id %></p><% end %>
  <table class="mt-3 w-full text-left text-sm"><thead><tr><th>Source</th><th>Capture</th><th>Result</th><th>Original bytes</th></tr></thead><tbody>
  <% @page[:sources].each do |source| %><tr><td class="p-2"><%= source['id'] %> · <%= source['type'] %><p><%= source['url'] %></p></td><td class="p-2"><%= source['captured_at'] %><p><%= source['snapshot_sha256'] %></p></td><td class="p-2"><%= source['failure'].presence || source['http_status'] %></td><td class="p-2"><% if source['snapshot_location'] %><%= link_to 'Download retained source', source_admin_departure_batch_path(@batch, attempt_id: @page[:source_attempt].id, source_id: source['id']), class: 'text-blue-700 underline' %><% end %></td></tr><% end %>
  </tbody></table>
  <p><% if @page[:sources_page].positive? %><%= link_to 'Previous sources', admin_departure_batch_path(@batch, attempt_id: @page[:source_attempt].id, sources_page: @page[:sources_page] - 1), class: 'mr-4 text-blue-700 underline' %><% end %><% if @page[:sources_next] %><%= link_to 'Next sources', admin_departure_batch_path(@batch, attempt_id: @page[:source_attempt].id, sources_page: @page[:sources_page] + 1), class: 'text-blue-700 underline' %><% end %></p>
  <h3 class="mt-4 font-semibold">Recent acquisition history</h3><ul><% @page[:history].each do |attempt| %><li><%= link_to "Attempt ##{attempt.id}", admin_departure_batch_path(@batch, attempt_id: attempt.id), class: 'text-blue-700 underline' %> · <%= attempt.status %> · <%= attempt.finished_at %> · <%= attempt.failure %></li><% end %></ul>
  <p><% if @page[:history_page].positive? %><%= link_to 'Newer attempts', admin_departure_batch_path(@batch, history_page: @page[:history_page] - 1), class: 'mr-4 text-blue-700 underline' %><% end %><% if @page[:history_next] %><%= link_to 'Older attempts', admin_departure_batch_path(@batch, history_page: @page[:history_page] + 1), class: 'text-blue-700 underline' %><% end %></p>
</details>
