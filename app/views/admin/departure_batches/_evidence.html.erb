<details class="rounded border p-5" data-source-details>
  <summary class="cursor-pointer text-lg font-semibold">Source details and attempt history</summary>
  <div class="mt-4 space-y-4">
    <% @page[:history].each do |attempt| %>
      <section class="rounded border p-4 space-y-3"><h3 class="font-semibold">Attempt #<%= attempt.id %>: <%= attempt.status.humanize %></h3>
        <p class="text-sm">Started <%= attempt.started_at || 'not yet' %>; finished <%= attempt.finished_at || 'not yet' %><% if attempt.predecessor_id %>; follows attempt #<%= attempt.predecessor_id %><% end %>. <%= attempt.failure %></p>
        <% attempt.manifest.fetch('sources', []).each do |source| %>
          <div class="rounded bg-gray-50 p-3 space-y-1 text-sm break-words"><p class="font-medium"><%= departure_source_label(source) %></p>
            <p><%= link_to source['url'], source['url'], class: 'text-blue-700 underline' %></p><p>HTTP <%= source['http_status'] || 'unknown' %> · captured <%= source['captured_at'] || 'not captured' %> · observed <%= source['observed_at'] %> · published <%= source['source_as_of'] || source['source_as_of_reason'] %></p>
            <% if source['failure'] %><p class="text-red-700"><%= source['failure'] %></p><% end %>
            <% if source['snapshot_location'] %><%= link_to 'Download retained source', source_admin_departure_batch_path(@batch, attempt_id: attempt.id, source_id: source['id']), class: 'text-blue-700 underline' %><% end %>
          </div>
        <% end %>
        <% if attempt.manifest['captures'] %><details class="rounded border p-3"><summary class="cursor-pointer font-medium">HTTP response ledger (<%= attempt.manifest['captures'].size %> requests including retries)</summary><div class="mt-3 space-y-3">
          <% attempt.manifest['captures'].each do |capture| %><div class="break-words text-sm"><p><%= capture['id'] %> · <%= capture['request'] %> · HTTP <%= capture['http_status'] %> · <%= capture['outcome'] %> · captured <%= capture['captured_at'] %> · redacted <%= capture['sanitized'] %> · rate limits <%= capture['headers'] %></p><%= link_to 'Download retained response', source_admin_departure_batch_path(@batch, attempt_id: attempt.id, source_id: capture['id']), class: 'text-blue-700 underline' %></div><% end %>
        </div></details><% end %>
        <% Array(attempt['source_failures']).each do |failure| %><p class="rounded bg-red-100 p-3"><%= failure['id'] %>: <%= failure['failure'] %></p><% end %>
      </section>
    <% end %>
  </div>
</details>
