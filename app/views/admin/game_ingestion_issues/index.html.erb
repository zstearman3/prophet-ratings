<% issue_ui = Admin::GameIngestionIssuesHelper %>
<div class="max-w-6xl mx-auto p-4 space-y-4">
  <h1 class="text-2xl font-bold">Game ingestion issues</h1>
  <%= form_with url: admin_game_ingestion_issues_path, method: :get, local: true, class: 'flex flex-wrap gap-3' do |f| %>
    <%= f.label :season_id, 'Season' %><%= f.select :season_id, @page[:seasons].map { |s| [s.year, s.id] }, include_blank: 'All seasons', selected: params[:season_id] %>
    <%= f.label :date, 'Date' %><%= f.date_field :date, value: params[:date] %>
    <%= f.label :category, 'Issue' %><%= f.select :category, Admin::GameIngestionIssuesHelper::ISSUE_LABELS.map { |key, label| [label, key] }, include_blank: 'All issues', selected: params[:category] %>
    <%= f.label :state, 'State' %><%= f.select :state, [['Open', 'open'], ['Resolved', 'resolved'], ['All', 'all']], selected: params[:state] %>
    <%= f.submit 'Filter', class: 'rounded bg-indigo-700 text-white px-3 py-1' %>
  <% end %>
  <table class="w-full text-left"><thead><tr><th>Date</th><th>Matchup</th><th>Issue</th><th>State</th></tr></thead><tbody>
    <% @page[:issues].each do |issue| %>
      <tr class="border-t"><td class="p-2"><%= issue.schedule_date %></td><td class="p-2"><%= link_to issue_ui.ingestion_issue_matchup(issue), admin_game_ingestion_issue_path(issue), class: 'text-blue-700 underline' %></td><td><%= issue_ui.ingestion_issue_title(issue) %></td><td><%= issue.state.humanize %></td></tr>
    <% end %>
  </tbody></table>
  <% if @page[:issues].empty? %><p>No issues match these filters.</p><% end %>
  <% if @page[:page_number] > 1 %><%= link_to 'Previous', admin_game_ingestion_issues_path(request.query_parameters.merge(page: @page[:page_number] - 1)) %><% end %>
  <% if @page[:issues].size == 50 %><%= link_to 'Next', admin_game_ingestion_issues_path(request.query_parameters.merge(page: @page[:page_number] + 1)) %><% end %>
</div>
