<section class="mx-auto max-w-5xl space-y-8 pb-12">
  <header class="space-y-3">
    <h1 class="text-3xl font-bold"><%= @run.historical? ? 'Historical import' : 'Schedule refresh' %> <%= @run.id %> · season <%= @run.season.year %></h1>
    <nav class="flex flex-wrap gap-4">
      <%= link_to 'Return to schedule review', admin_schedule_refresh_runs_path(season_id: @run.season.id), class: 'text-blue-700 underline' %>
      <%= link_to 'Return to offseason setup', admin_offseason_setup_path(season_id: @run.season.id), class: 'text-blue-700 underline' %>
    </nav>
  </header>
  <section class="rounded border bg-gray-50 p-5 space-y-3" data-status="<%= @run.status %>">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-xl font-semibold"><%= @run.status.humanize %></h2>
      <%= link_to 'Refresh status', admin_schedule_refresh_run_path(@run), class: 'rounded border bg-white px-4 py-2 font-medium hover:bg-gray-100' %>
    </div>
    <p><%= @run.cbbd? ? 'CBBD' : 'Sports Reference' %> · <%= @run.start_date %>–<%= @run.end_date %> inclusive Eastern.</p>
    <% unless ScheduleRefreshRun::TERMINAL.include?(@run.status) %><p role="status">Your import runs in the background. Refresh status to see completed dates and any errors.</p><% end %>
    <% if @run.historical? %><p><%= @run.rescan? ? 'Reimporting completed dates as well as unfinished dates.' : 'Resuming unfinished dates; previously imported dates are skipped.' %></p><% end %>
    <% if @run.error.present? %><p role="alert" class="rounded bg-red-100 p-3"><%= @run.error %></p><% end %>
    <% if @run.report['acquisition_complete'] == false %>
      <div role="alert" class="rounded bg-red-100 p-3 space-y-2">
        <p class="font-semibold"><%= @run.cbbd? ? 'CBBD' : 'Source' %> retrieval failed</p>
        <p><%= schedule_acquisition_issues(@run.report).presence || 'The source response was incomplete. Review retained acquisition details before retrying.' %></p>
        <p>No team matching changes are needed to resolve a retrieval failure.</p>
      </div>
    <% end %>
    <p class="text-sm text-gray-600">Successful or empty acquisition does not certify complete publication, reviewed reconciliation, or prediction readiness. No games are deleted on source absence.</p>
  </section>
  <% if @run.retry_of %><p>Retry of <%= link_to "run #{@run.retry_of_id}", admin_schedule_refresh_run_path(@run.retry_of_id), class: 'text-blue-700 underline' %>.</p><% end %>
  <% if @run.retry_run %>
    <section class="rounded border bg-blue-50 p-5 space-y-2">
      <h2 class="font-semibold">Existing retry: <%= link_to "run #{@run.retry_run.id} (#{@run.retry_run.status})", admin_schedule_refresh_run_path(@run.retry_run), class: 'text-blue-700 underline' %></h2>
      <p>Continue from this linked run; each parent grants one retry budget.</p>
    </section>
  <% elsif ScheduleRefreshRun::TERMINAL.include?(@run.status) && @run.pending_dates.any? %>
    <section class="rounded border bg-yellow-50 p-5 space-y-3">
      <h2 class="font-semibold">Some dates still need importing</h2>
      <p>Failed or unattempted dates: <%= @run.pending_dates.join(', ') %>.</p>
      <p class="text-sm">Retry these dates in a linked run with a fresh budget at the original numeric limits. Review your request quota first.<% unless @run.historical? %> Expired dates require historical sync; start a historical import from schedule review.<% end %></p>
      <%= button_to 'Retry unfinished dates with new budget', retry_admin_schedule_refresh_run_path(@run), method: :post, class: 'rounded bg-prophet-indigo px-4 py-2 font-medium text-white' %>
    </section>
  <% end %>
  <section class="space-y-3">
    <h2 class="text-xl font-semibold">Results by date</h2>
    <p class="text-sm text-gray-600">Committed date evidence is saved as the import progresses. Open a date's details to inspect individual games and identity issues.</p>
    <% if @run.report.fetch('days', []).empty? %>
      <p class="rounded border bg-gray-50 p-4">No dates have completed yet.</p>
    <% else %>
      <div class="overflow-x-auto rounded border">
        <table class="w-full text-sm" id="schedule-import-results">
          <thead class="bg-gray-100 text-left"><tr><th class="p-3">Date</th><th class="p-3">Result</th><th class="p-3 text-right">Imported</th><th class="p-3 text-right">Changed</th><th class="p-3">Details</th></tr></thead>
          <tbody>
            <% @run.report.fetch('days', []).sort_by { |day| day['date'].to_s }.each do |day| %>
              <tr class="border-t align-top">
                <td class="p-3 whitespace-nowrap"><%= day['date'] %></td>
                <td class="p-3"><%= day['error'] ? (day.fetch('imported_rows', 0).positive? ? 'Partially imported' : 'Failed') : (day['status'] == 'skipped' ? 'Already imported' : (day['valid_empty'] ? 'No games' : 'Imported')) %></td>
                <td class="p-3 text-right"><%= day.fetch('imported_rows', 0) %></td>
                <td class="p-3 text-right"><%= day.fetch('changed_rows', 0) %></td>
                <td class="p-3"><%= render 'day_details', day: day %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
  <% if @run.report.fetch('absent_ids', []).any? %>
    <section class="rounded border p-5 space-y-3">
      <h2 class="text-xl font-semibold">Games absent from successful source dates</h2>
      <p>Review only: these games were not deleted.</p>
      <p><% @run.report.fetch('absent_ids', []).each do |id| %><%= @evidence[:games][id] ? link_to("Game #{id}", game_path(@evidence[:games][id]), class: 'mr-3 text-blue-700 underline') : id %> <% end %></p>
    </section>
  <% end %>
  <%= link_to 'Review CBBD identities', admin_cbbd_review_runs_path(season_id: @run.season.id), class: 'text-blue-700 underline' %>
  <details class="rounded border p-5 space-y-3 text-sm">
    <summary class="cursor-pointer font-semibold">Run details and request budget</summary>
    <p>Requested by <%= @run.requested_by.email %> at <%= @run.created_at %>. Started <%= @run.started_at || 'not yet' %>; finished <%= @run.finished_at || 'not yet' %>.</p>
    <p><%= @run.cbbd? ? "Total request ceiling: #{@run.max_requests}; retries per request: #{@run.retries}." : (@run.historical? ? 'Sports Reference: up to 5 retries per failed date, waits 5/10/20/40/80 seconds.' : 'Sports Reference: up to 3 retries per failed date, waits 5/10/20 seconds.') %></p>
    <p>Failed or unattempted dates: <%= @run.pending_dates.join(', ').presence || 'none' %>.</p>
  </details>
  <details class="rounded border p-5 space-y-3 text-sm"><summary class="cursor-pointer font-semibold">Safe retained acquisition and outcome counts</summary><pre class="overflow-auto rounded bg-gray-50 p-3"><%= JSON.pretty_generate(@run.report) %></pre></details>
</section>
