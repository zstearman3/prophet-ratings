<section class="mx-auto max-w-5xl space-y-5 pb-12">
  <h1 class="text-3xl font-bold">Offseason readiness — ending year <%= @page[:season].year %></h1>
  <p><%= @page[:season].start_date %> to <%= @page[:season].end_date %> · Selected model <%= @page[:report]['model_name'] || 'none' %></p>
  <p>Actual current season #<%= @page[:report]['current_season_id'] || 'none' %>; effective default model #<%= @page[:report]['default_model_id'] || 'none' %>.</p>
  <p>This review records operational evidence and unresolved work. It does not certify prediction accuracy or launch readiness. Saving a review changes neither current season nor default model.</p>
  <% if @page[:error] %><p role="alert"><%= @page[:error] %></p><% end %>
  <nav class="flex flex-wrap gap-3">
    <%= link_to 'Return to season dashboard', admin_offseason_setup_path(season_id: @page[:season].id) %>
    <%= link_to 'Memberships, aliases and dates', rails_admin.review_memberships_path(model_name: 'season', id: @page[:season].id) %>
    <%= link_to 'Recruiting', admin_recruiting_batches_path(season_id: @page[:season].id) %>
    <%= link_to 'Coaching', admin_coaching_review_path(@page[:season].year) %>
    <%= link_to 'Departures', admin_departure_batches_path(season_id: @page[:season].id) %>
    <%= link_to 'Model selection and preseason publication', admin_preseason_publications_path(season_id: @page[:season].id) %>
    <%= link_to 'Schedule and game reconciliation', admin_schedule_refresh_runs_path(season_id: @page[:season].id) %>
    <%= link_to 'Model analysis', admin_prediction_evaluation_path(season_id: @page[:season].id, model_id: @page[:report]['model_id']) %>
    <%= link_to 'GoodJob operations', '/good_job' %>
  </nav>
  <h2 class="text-2xl font-semibold">Fresh stored evidence</h2>
  <%= render 'checks', report: @page[:report], decisions: nil %>
  <%= form_with url: admin_offseason_readiness_reviews_path(season_id: @page[:season].id), method: :post do |form| %>
    <%= hidden_field_tag :fingerprint, @page[:report].fetch('fingerprint') %>
    <label><%= check_box_tag :acknowledge, '1' %> Acknowledge the exact captured and current input gaps shown above</label>
    <% @page[:report].fetch('checks').reject { |check| check['hard'] || check['status'] == 'pass' }.each do |check| %>
      <div class="my-3"><%= label_tag "deferrals_#{check['key']}", "Optional deferral reason: #{check['label']} (blank leaves open)" %>
      <%= text_area_tag "deferrals[#{check['key']}]", nil, maxlength: 1000, class: 'block w-full border' %></div>
    <% end %>
    <%= form.submit 'Save readiness review', class: 'rounded bg-blue-800 px-4 py-2 text-white' %>
  <% end %>
  <h2 class="text-xl font-semibold">Retained reviews</h2>
  <% @page[:reviews].each do |review| %><p><%= link_to "Review ##{review.id} by admin ##{review.reviewer_id} at #{review.created_at}", admin_offseason_readiness_review_path(review, season_id: @page[:season].id) %> · <%= review.results.keys.join(', ') %></p><% end %>
</section>
