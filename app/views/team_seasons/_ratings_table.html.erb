<% compact = local_assigns.fetch(:compact, false) %>
<% national_rank = local_assigns.fetch(:national_rank, false) %>
<% selected_season = local_assigns[:selected_season] %>
<% expanded_conference = national_rank && !compact %>
<% cell_padding = compact ? 'px-1' : (expanded_conference ? 'px-2' : 'px-4') %>
<% columns = [
  ['Rating', :rating, 'rating', 'desc'],
  ['Adj ORtg', :adj_offensive_efficiency, 'adj_offensive_efficiency', 'desc'],
  ['Adj DRtg', :adj_defensive_efficiency, 'adj_defensive_efficiency', 'asc'],
  ['Adj Pace', :adj_pace, 'adj_pace', 'desc'],
  ['Adj TO%', :adj_turnover_rate, 'adj_turnover_rate', 'asc'],
  ['Adj TO% Forced', :adj_turnover_rate_forced, 'adj_turnover_rate_forced', 'desc'],
  ['Adj ORB%', :adj_offensive_rebound_rate, 'adj_offensive_rebound_rate', 'desc'],
  ['Adj DRB%', :adj_defensive_rebound_rate, 'adj_defensive_rebound_rate', 'desc'],
  ['Adj FT Rate', :adj_free_throw_rate, 'adj_free_throw_rate', 'desc'],
  ['Adj 3PT Prof', :adj_three_pt_proficiency, 'adj_three_pt_proficiency', 'desc'],
  ['Adj 3PT Prof Allowed', :adj_three_pt_proficiency_allowed, 'adj_three_pt_proficiency_allowed', 'asc'],
  ['Adj eFG%', :adj_effective_fg_percentage, 'adj_effective_fg_percentage', 'desc'],
  ['Adj eFG% Allowed', :adj_effective_fg_percentage_allowed, 'adj_effective_fg_percentage_allowed', 'asc'],
  ['Raw ORtg', :offensive_efficiency, 'offensive_efficiency', 'desc'],
  ['Raw DRtg', :defensive_efficiency, 'defensive_efficiency', 'desc'],
  ['Raw Pace', :pace, 'pace', 'desc'],
  ['Raw eFG%', :effective_fg_percentage, 'effective_fg_percentage', 'desc'],
  ['Raw FT Rate', :free_throw_rate, 'free_throw_rate', 'desc'],
  ['Raw 3PA Rate', :three_pt_attempt_rate, 'three_pt_attempt_rate', 'desc'],
  ['Raw ORB%', :offensive_rebound_rate, 'offensive_rebound_rate', 'desc'],
  ['Raw TO%', :turnover_rate, 'turnover_rate', 'asc'],
  ['Home Off Boost', :home_offense_boost, 'home_offense_boost', 'desc'],
  ['Home Def Boost', :home_defense_boost, 'home_defense_boost', 'asc'],
  ['Total Home Boost', :total_home_boost, 'total_home_boost', 'desc'],
  ['Off Volatility', :offensive_efficiency_volatility, 'offensive_efficiency_volatility', 'desc'],
  ['Def Volatility', :defensive_efficiency_volatility, 'defensive_efficiency_volatility', 'desc'],
  ['Pace Volatility', :pace_volatility, 'pace_volatility', 'desc'],
  ['ORtg Std Dev', :offensive_efficiency_std_dev, 'offensive_efficiency_std_dev', 'desc'],
  ['DRtg Std Dev', :defensive_efficiency_std_dev, 'defensive_efficiency_std_dev', 'desc']
] %>
<% shown_columns = compact ? columns.first(1) : columns %>
<% rank_label = national_rank ? 'National rank' : 'Rank' %>
<% header_cells = [[rank_label, nil, nil, nil], ['School', nil, 'school', 'asc']] + shown_columns %>
<div class="<%= compact ? '' : (local_assigns.fetch(:scrollable, false) ? 'table-responsive max-h-screen' : 'table-responsive max-h-screen overflow-auto') %>">
  <table class="text-sm text-left text-gray-500 border-separate border-spacing-0 <%= compact ? 'w-full table-fixed' : '' %>">
    <% if compact %>
      <colgroup><col class="w-16"><col><col class="w-[4.5rem]"></colgroup>
    <% elsif expanded_conference %>
      <colgroup><col class="w-[4.5rem]"><col class="w-48"></colgroup>
    <% end %>
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 <%= compact ? '' : 'sticky top-0 z-20' %>">
      <tr>
        <% header_cells.each_with_index do |(label, _attribute, sort_key, _default_direction), index| %>
          <% sticky = if expanded_conference && index < 2
                        index.zero? ? 'sm:sticky sm:left-0 sm:z-30' : 'sm:sticky sm:left-[4.5rem] sm:z-30'
                      elsif !compact && index < 2
                        index.zero? ? 'sticky left-0 z-30' : 'sticky left-[60px] z-30'
                      else
                        ''
                      end %>
          <% width = compact ? (index == 0 ? 'w-16' : index == 2 ? 'w-[4.5rem]' : '') : expanded_conference && index == 0 ? 'w-[4.5rem]' : expanded_conference && index == 1 ? 'w-48' : '' %>
          <% wrapping_header = compact && index < 2 || expanded_conference && index == 0 %>
          <th class="<%= cell_padding %> py-2 bg-gray-50 <%= sticky %> <%= width %> <%= wrapping_header ? 'whitespace-normal break-words' : 'whitespace-nowrap' %>">
            <% if sort_key %>
              <% direction = params[:sort] == sort_key ? (params[:direction] == 'asc' ? 'desc' : 'asc') : _default_direction %>
              <% sort_url = url_for(request.query_parameters.merge(sort: sort_key, direction: direction)) %>
              <%= link_to label, sort_url, class: 'hover:underline' %>
              <% if params[:sort] == sort_key %><%= params[:direction] == 'asc' ? '▲' : '▼' %><% end %>
            <% else %>
              <%= label %>
            <% end %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% team_seasons.each_with_index do |team_season, index| %>
        <% row_class = index.even? ? 'bg-white' : 'bg-gray-50' %>
        <tr class="odd:bg-white even:bg-gray-50">
          <% rank_identity = expanded_conference ? 'sm:sticky sm:left-0 sm:z-10' : compact ? 'whitespace-normal break-words' : 'sticky left-0 z-10' %>
          <% school_identity = expanded_conference ? 'sm:sticky sm:left-[4.5rem] sm:z-10 w-48 whitespace-normal break-all' : compact ? 'whitespace-normal break-words' : 'sticky left-[60px] z-10' %>
          <td class="border-b border-gray-300 <%= cell_padding %> py-2 <%= rank_identity %> <%= compact ? '' : row_class %>"><%= national_rank ? (team_season.overall_rank || '—') : index + 1 %></td>
          <td class="border-b border-gray-300 <%= cell_padding %> py-2 <%= school_identity %> <%= compact ? '' : row_class %>"><%= link_to team_season.team.school, team_path(team_season.team, (national_rank && selected_season ? { year: selected_season.year } : {})), data: { turbo: false }, class: (compact ? 'block whitespace-normal break-words' : expanded_conference ? 'block w-48 break-all' : nil) %></td>
          <% shown_columns.each do |_label, attribute, _sort_key, _default_direction| %>
            <% value = team_season.public_send(attribute) %>
            <td class="border-b border-gray-300 <%= cell_padding %> py-2 <%= compact ? 'whitespace-nowrap' : '' %>"><%= national_rank && value.nil? ? '—' : value %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
