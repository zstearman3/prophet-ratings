<% content_for :page_title, 'Admin Sign In | Prophet Ratings' %>

<section class="mx-auto max-w-md py-8 sm:py-16" aria-labelledby="sign-in-heading">
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="h-1.5 bg-prophet-indigo" aria-hidden="true"></div>
    <div class="p-6 sm:p-8">
      <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-prophet-indigo">Prophet Ratings</p>
      <h1 id="sign-in-heading" class="text-2xl font-bold text-prophet-black">Admin sign in</h1>
      <p class="mt-2 text-sm text-slate-600">Sign in to manage Prophet Ratings.</p>

      <% if alert.present? %>
        <div role="alert" class="mt-6 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"><%= alert %></div>
      <% end %>
      <% if notice.present? %>
        <div role="status" class="mt-6 rounded-lg border border-slate-200 bg-prophet-seasalt p-3 text-sm text-slate-700"><%= notice %></div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'mt-6 space-y-5' }) do |form| %>
        <div>
          <%= form.label :email, class: 'mb-2 block text-sm font-medium text-prophet-black' %>
          <%= form.email_field :email, autofocus: true, autocomplete: 'username', required: true,
                class: 'block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-prophet-black shadow-sm focus:border-prophet-indigo focus:outline-none focus:ring-2 focus:ring-prophet-indigo/25' %>
        </div>

        <div>
          <%= form.label :password, class: 'mb-2 block text-sm font-medium text-prophet-black' %>
          <%= form.password_field :password, autocomplete: 'current-password', required: true,
                class: 'block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-prophet-black shadow-sm focus:border-prophet-indigo focus:outline-none focus:ring-2 focus:ring-prophet-indigo/25' %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= form.check_box :remember_me, class: 'h-4 w-4 rounded border-slate-300 accent-prophet-indigo focus:ring-2 focus:ring-prophet-indigo' %>
            <%= form.label :remember_me, class: 'text-sm text-slate-600' %>
          </div>
        <% end %>

        <%= form.submit 'Sign in', class: 'w-full cursor-pointer rounded-lg bg-prophet-indigo px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-prophet-indigo/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-prophet-indigo' %>
      <% end %>
    </div>
  </div>

  <p class="mt-6 text-center text-sm">
    <%= link_to 'Back to ratings', root_path, class: 'rounded text-slate-600 hover:text-prophet-indigo focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-prophet-indigo' %>
  </p>
</section>
