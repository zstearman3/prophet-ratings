<h1 class="text-xl font-bold mb-4">Schedule for <%= @date.strftime('%B %d, %Y') %></h1>

<%= form_with url: schedule_games_path, method: :get, local: true, class: "mb-4 flex flex-wrap items-center gap-2" do |form| %>
  <%= form.label :date, "Date:", class: "font-semibold" %>
  <%= form.date_field :date, value: @date, class: "border rounded px-2 py-1" %>
  <%= form.submit "Go", class: "bg-prophet-indigo hover:bg-prophet-indigo/80 text-white font-bold py-2 px-4 rounded inline-flex items-center space-x-2" %>
<% end %>

<p id="schedule-scroll-hint" class="mb-2 text-sm text-gray-500">Scroll horizontally to see all columns.</p>
<div class="w-full max-w-full overflow-x-auto" role="region" aria-label="Schedule" aria-describedby="schedule-scroll-hint" tabindex="0">
  <table class="table-auto w-full border">
    <thead>
      <tr class="bg-gray-100">
        <th class="px-4 py-2 text-left">Matchup</th>
        <th class="px-4 py-2 text-left">Status</th>
        <th class="px-4 py-2 text-left">Score</th>
        <th class="px-4 py-2 text-left">Prediction</th>
      </tr>
    </thead>
    <tbody>
      <% @games.each do |game| %>
        <tr class="border-t">
          <td class="px-4 py-2 font-semibold">
            <%= link_to "#{game.away_team_name} @ #{game.home_team_name}", game_path(game),
              class: "text-gray-800 hover:text-blue-600" %>
          </td>
          <td class="px-4 py-2">
            <% status = game.status_string.upcase %>
            <% badge_class, badge_label = case
              when status.include?("FINAL")
                ["bg-green-100 text-green-700", game.status_string]
              when status.include?("SCHEDULED")
                ["bg-gray-100 text-gray-600", "Scheduled"]
              when status.include?("CANCELED")
                ["bg-red-100 text-red-700", "Canceled"]
              else
                ["bg-gray-100 text-gray-600", game.status_string]
            end %>
            <span class="text-xs px-2 py-0.5 rounded <%= badge_class %>"><%= badge_label %></span>
          </td>
          <td class="px-4 py-2">
            <% if game.completed? %>
              <%= game.away_team_score && game.home_team_score ? "#{game.away_team_score} - #{game.home_team_score}" : 'N/A' %>
            <% else %>
              -
            <% end %>
          </td>
          <td class="px-4 py-2">
            <% historical_prediction = game.historical_prediction(ratings_config_version: @ratings_config_version) %>
            <% prediction = historical_prediction || game.current_prediction(ratings_config_version: @ratings_config_version) %>
            <% if prediction.present? %>
              <% prediction_label = if historical_prediction
                   prediction.forecast_kind == 'pregame' ? 'Historical pregame forecast' : "Historical · #{prediction.provenance_label}"
                 else
                   prediction.provenance_label
                 end %>
              <% if prediction.home_score && prediction.away_score %>
                <%= link_to prediction.predicted_score_string, game_path(game),
                  title: prediction_label, class: "inline-block text-gray-800 hover:text-blue-600" %>
              <% else %>
                <span title="<%= prediction_label %>" class="inline-block text-xs text-gray-400">Prediction unavailable</span>
              <% end %>
              <%= render 'shared/forecast_provenance', prediction:, label: prediction_label %>
              <% if prediction.home_win_probability %>
                <span class="block text-xs text-gray-500"><%= historical_prediction ? 'Captured home win probability' : 'Home win' %>: <%= number_to_percentage(prediction.home_win_probability * 100, precision: 1) %></span>
              <% end %>
            <% else %>
              <span class="text-xs text-gray-400"><%= game.current_prediction_unavailable_reason&.humanize || 'No prediction' %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
      <% if @games.empty? %>
        <tr>
          <td colspan="4" class="text-center text-gray-400 py-4">No games scheduled for this date.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
