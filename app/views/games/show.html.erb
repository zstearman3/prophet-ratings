<% if current_user&.admin? %>
  <p><%= link_to 'Return to schedule review', admin_schedule_refresh_runs_path(season_id: @game.season_id) %>
    <%= link_to 'Edit game', rails_admin.edit_path(model_name: 'game', id: @game.id) %></p>
<% end %>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="py-6">
    <div class="flex flex-col justify-evenly">
      <div class="flex justify-evenly">
        <div class="flex flex-col items-center">
          <div class="flex items-center">
            <h1 class="text-2xl font-bold text-prophet-black">
              <% if @game.away_team_game&.team %>
                <span class="text-sm text-gray-600 mr-2"><%= @game.away_team_game&.team_season&.rank ? "##{@game.away_team_game.team_season.rank}" : 'N/A' %></span>
                <%= link_to @game.away_team_game.team.school, team_path(@game.away_team_game.team), class: "hover:text-blue-600" %>
              <% else %>
                <%= @game.away_team_name %>
              <% end %>
            </h1>
          </div>
          <span class="text-2xl font-bold text-prophet-black mt-2"><%= @game.completed? ? (@game.away_team_score || 'N/A') : '-' %></span>
        </div>
        <div class="flex flex-col items-center">
          <div class="flex items-center">
            <h1 class="text-2xl font-bold text-prophet-black">
              <% if @game.home_team_game&.team %>
                <span class="text-sm text-gray-600 mr-2"><%= @game.home_team_game&.team_season&.rank ? "##{@game.home_team_game.team_season.rank}" : 'N/A' %></span>
                <%= link_to @game.home_team_game.team.school, team_path(@game.home_team_game.team), class: "hover:text-blue-600" %>
              <% else %>
                <%= @game.home_team_name %>
              <% end %>
            </h1>
          </div>
          <span class="text-2xl font-bold text-prophet-black mt-2"><%= @game.completed? ? (@game.home_team_score || 'N/A') : '-' %></span>
        </div>
      </div>
    </div>

    <div class="mt-4">
      <p class="text-gray-600 text-center">Date: <%= @game.start_time.strftime("%B %d, %Y") %> · <%= @game.completed? ? @game.status_string : @game.status.titleize %></p>
      <% if @game.venue_name.present? %>
        <p class="text-gray-600 text-center">Venue: <%= @game.venue_name %></p>
      <% end %>
    </div>

    <div class="mt-8">
      <% if @game.completed? %>
        <h2 class="text-xl font-semibold text-prophet-black mb-4">Box Score</h2>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Team</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">FG</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">3P</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">FT</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reb</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ast</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Stl</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Blk</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">TO</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">FG%</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">3P%</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">FT%</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">OReb</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">DReb</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Off Eff</th>
                <th class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Def Eff</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr>
                <td class="px-3 py-2 whitespace-nowrap">
                  <div class="flex items-center">
                    <span class="text-sm text-gray-600 mr-2"><%= @game.away_team_game&.team_season&.rank ? "##{@game.away_team_game.team_season.rank}" : 'N/A' %></span>
                    <span class="text-sm font-medium text-prophet-black">
                      <% if @game.away_team_game&.team %>
                        <%= link_to @game.away_team_game.team.school, team_path(@game.away_team_game.team), class: "hover:text-blue-600" %>
                      <% else %>
                        <%= @game.away_team_name %>
                      <% end %>
                    </span>
                  </div>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.field_goals_made && @game.away_team_game&.field_goals_attempted ? "#{@game.away_team_game.field_goals_made}/#{@game.away_team_game.field_goals_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.three_pt_made && @game.away_team_game&.three_pt_attempted ? "#{@game.away_team_game.three_pt_made}/#{@game.away_team_game.three_pt_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.free_throws_made && @game.away_team_game&.free_throws_attempted ? "#{@game.away_team_game.free_throws_made}/#{@game.away_team_game.free_throws_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.assists || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.steals || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.blocks || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.turnovers || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.field_goals_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.three_pt_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.free_throws_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.offensive_rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.defensive_rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.offensive_rating || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.away_team_game&.defensive_rating || 'N/A' %>
                </td>
              </tr>
              <tr>
                <td class="px-3 py-2 whitespace-nowrap">
                  <div class="flex items-center">
                    <span class="text-sm text-gray-600 mr-2"><%= @game.home_team_game&.team_season&.rank ? "##{@game.home_team_game.team_season.rank}" : 'N/A' %></span>
                    <span class="text-sm font-medium text-prophet-black">
                      <% if @game.home_team_game&.team %>
                        <%= link_to @game.home_team_game.team.school, team_path(@game.home_team_game.team), class: "hover:text-blue-600" %>
                      <% else %>
                        <%= @game.home_team_name %>
                      <% end %>
                    </span>
                  </div>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.field_goals_made && @game.home_team_game&.field_goals_attempted ? "#{@game.home_team_game.field_goals_made}/#{@game.home_team_game.field_goals_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.three_pt_made && @game.home_team_game&.three_pt_attempted ? "#{@game.home_team_game.three_pt_made}/#{@game.home_team_game.three_pt_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.free_throws_made && @game.home_team_game&.free_throws_attempted ? "#{@game.home_team_game.free_throws_made}/#{@game.home_team_game.free_throws_attempted}" : 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.assists || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.steals || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.blocks || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.turnovers || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.field_goals_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.three_pt_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.free_throws_percentage&.then { |p| "#{number_with_precision(p * 100, precision: 1)}%" } || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.offensive_rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.defensive_rebounds || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.offensive_rating || 'N/A' %>
                </td>
                <td class="px-3 py-2 whitespace-nowrap text-sm text-prophet-black">
                  <%= @game.home_team_game&.defensive_rating || 'N/A' %>
                </td>
              </tr>
            </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <h2 class="text-xl font-semibold text-prophet-black mb-4">Box Score</h2>
        <div class="bg-white p-6 rounded-lg shadow">
          <p class="text-gray-600">Box score is available after the game is final.</p>
        </div>
      <% end %>
    </div>

    <div class="mt-8">
      <div class="flex items-center gap-1 mb-4">
        <h2 class="text-xl font-semibold text-prophet-black">Prediction Analysis</h2>
        <% forecast = @prediction || @historical_prediction %>
        <% if forecast %>
          <% prediction_label = @historical_prediction ? (forecast.forecast_kind == 'pregame' ? 'Historical pregame forecast' : "Historical · #{forecast.provenance_label}") : forecast.provenance_label %>
          <%= render 'shared/forecast_provenance', prediction: forecast, label: prediction_label %>
        <% end %>
      </div>
      <% if @prediction %>
        <div class="bg-white p-6 rounded-lg shadow">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <h3 class="text-lg font-semibold text-prophet-black mb-2"><%= @game.final_unmatched? ? 'Historical pregame forecast' : 'Predicted Outcome' %></h3>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <span class="text-gray-600">Favorite:</span>
                  <span class="font-medium">
                    <% favorite = @prediction.home_score && @prediction.away_score ? @prediction.favorite : nil %>
                    <%= favorite ? link_to(favorite.school, team_path(favorite), class: "hover:text-blue-600") : 'N/A' %>
                  </span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Win Probability:</span>
                  <span class="font-medium"><%= @prediction.home_score && @prediction.away_score && @prediction.home_win_probability ? "#{(@prediction.favorite_win_probability * 100).round(1)}%" : 'N/A' %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Predicted Score:</span>
                  <span class="font-medium"><%= @prediction.home_score && @prediction.away_score ? @prediction.predicted_score_string : 'N/A' %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Predicted Total:</span>
                  <span class="font-medium"><%= @prediction.home_score && @prediction.away_score ? @prediction.total : 'N/A' %></span>
                </div>
              </div>
            </div>

            <% if @game.final? %>
              <div>
                <h3 class="text-lg font-semibold text-prophet-black mb-2">Actual Outcome</h3>
                <div class="space-y-2">
                  <div class="flex justify-between">
                    <span class="text-gray-600">Winning Team:</span>
                    <span class="font-medium">
                      <% winner = @game.home_team_score && @game.away_team_score ? @game.winning_team : nil %>
                      <% if winner %>
                        <%= link_to winner.school, team_path(winner), class: "hover:text-blue-600" %>
                      <% elsif @game.home_team_score && @game.away_team_score %>
                        <%= @game.home_team_score > @game.away_team_score ? @game.home_team_name : @game.away_team_name %>
                      <% else %>
                        N/A
                      <% end %>
                    </span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Status:</span>
                    <span class="font-medium"><%= @game.status_string %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Final Score:</span>
                  <span class="font-medium"><%= @game.away_team_score && @game.home_team_score ? "#{@game.away_team_score} - #{@game.home_team_score}" : 'N/A' %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Total Points:</span>
                  <span class="font-medium"><%= @game.home_team_score && @game.away_team_score ? @game.home_team_score + @game.away_team_score : 'N/A' %></span>
                  </div>
                </div>
              </div>
            <% else %>
              <div>
                <h3 class="text-lg font-semibold text-prophet-black mb-2">Game Status</h3>
                <div class="space-y-2">
                  <div class="flex justify-between">
                    <span class="text-gray-600">Status:</span>
                    <span class="font-medium"><%= @game.status_string %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Score:</span>
                  <span class="font-medium"><%= if @game.completed?
                                                    @game.away_team_score && @game.home_team_score ? "#{@game.away_team_score} - #{@game.home_team_score}" : 'N/A'
                                                  else
                                                    '-'
                                                  end %></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @historical_prediction %>
        <% captured_teams = @historical_prediction.forecast_kind == 'pregame' ? @historical_prediction.calculation_context.fetch('snapshots', []).map { |snapshot| snapshot['school'] } : [] %>
        <div class="bg-white p-6 rounded-lg shadow">
          <% if @historical_prediction.away_score && @historical_prediction.home_score %>
            <p><%= captured_teams[1].presence || 'Away team' %> <%= @historical_prediction.away_score.round %> - <%= captured_teams[0].presence || 'Home team' %> <%= @historical_prediction.home_score.round %></p>
          <% else %>
            <p class="text-gray-600">Prediction unavailable.</p>
          <% end %>
          <% if @historical_prediction.home_win_probability %>
            <p class="text-sm text-gray-600">Captured home win probability: <%= number_to_percentage(@historical_prediction.home_win_probability * 100, precision: 1) %></p>
          <% end %>
          <p class="mt-2 text-sm text-gray-600">This saved forecast is historical and has no evaluation result for the unmatched final.</p>
        </div>
      <% else %>
        <div class="bg-white p-6 rounded-lg shadow">
          <p class="text-gray-600"><%= @game.final_unmatched? ? 'No prediction available for this game.' : (@game.current_prediction_unavailable_reason(ratings_config_version: @config)&.humanize || 'No prediction available for this game.') %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
