<% if recommendation.recommended? %>
  <div><span class="font-semibold">Recommended bet:</span> <%= recommendation.evaluated_selection || 'Not saved' %></div>
<% else %>
  <div class="font-semibold">No play</div>
  <div><span class="font-semibold">Evaluated side:</span> <%= recommendation.evaluated_selection || 'Not saved' %></div>
<% end %>
<% unless recommendation.moneyline_bet_type? %>
  <div><span class="font-semibold">Odds:</span> <%= format('%+g', recommendation.vegas_odds) %></div>
<% end %>
<div title="Model-estimated profit: <%= number_to_currency(recommendation.ev * 100) %> per $100 wagered."><span class="font-semibold">Expected ROI:</span> <%= format('%+.1f%%', recommendation.ev * 100) %></div>
<div title="Uncalibrated model estimate"><span class="font-semibold">Model <%= probability_label %> probability:</span> <%= (recommendation.confidence * 100).round(1) %>%</div>
