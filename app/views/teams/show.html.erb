<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="py-6">
    <div class="flex items-center">
      <span class="text-md text-gray-600 mr-2">#<%= @team_season.rank %></span>
      <h1 class="text-2xl font-bold text-prophet-black"><%= @team.school %></h1>
      <span class="text-2xl text-gray-600 ml-2"><%= @team.nickname %></span>
    </div>
    <div class="flex items-center">
      <span class="text-sm text-gray-600 mr-2">
        <% conference = @team_season.conference %>
        <%= "#{@team_season.wins}-#{@team_season.losses} (#{@team_season.conference_wins}-#{@team_season.conference_losses} in " %><%= conference ? link_to(conference.abbreviation.presence || conference.name, conference_path(conference, season: @season.year)) : 'Independent' %>)
      </span>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-prophet-black mb-4">Adjusted Stats</h2>
      <% if @snapshots.last %>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-600">Rating</p>
            <p class="text-lg font-semibold text-prophet-black"><%= @snapshots.last.rating&.round(1) || 'N/A' %>
              <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.overall_rank ? "##{@snapshots.last.overall_rank}" : 'N/A' %></span>
            </p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-600">Adj ORtg</p>
            <p class="text-lg font-semibold text-prophet-black"><%= @snapshots.last.adj_offensive_efficiency&.round(1) || 'N/A' %>
              <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_offensive_efficiency_rank ? "##{@snapshots.last.adj_offensive_efficiency_rank}" : 'N/A' %></span>
            </p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-600">Adj DRtg</p>
            <p class="text-lg font-semibold text-prophet-black"><%= @snapshots.last.adj_defensive_efficiency&.round(1) || 'N/A' %>
              <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_defensive_efficiency_rank ? "##{@snapshots.last.adj_defensive_efficiency_rank}" : 'N/A' %></span>
            </p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <p class="text-sm text-gray-600">Adj Pace</p>
            <p class="text-lg font-semibold text-prophet-black"><%= @snapshots.last.adj_pace&.round(1) || 'N/A' %>
              <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_pace_rank ? "##{@snapshots.last.adj_pace_rank}" : 'N/A' %></span>
            </p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-prophet-black mb-4">Adjusted Five Factors</h2>
      <% if @snapshots.last %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Offense -->
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Offense</h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div>
                <p class="text-gray-600">eFG%</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_effective_fg_percentage&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_effective_fg_percentage_rank ? "##{@snapshots.last.adj_effective_fg_percentage_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">TO%</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_turnover_rate&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_turnover_rate_rank ? "##{@snapshots.last.adj_turnover_rate_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">ORB%</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_offensive_rebound_rate&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_offensive_rebound_rate_rank ? "##{@snapshots.last.adj_offensive_rebound_rate_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">FT Rate</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_free_throw_rate&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_free_throw_rate_rank ? "##{@snapshots.last.adj_free_throw_rate_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">3PT Proficiency</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_three_pt_proficiency&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_three_pt_proficiency_rank ? "##{@snapshots.last.adj_three_pt_proficiency_rank}" : 'N/A' %></span>
                </p>
              </div>
            </div>
          </div>

          <!-- Defense -->
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-sm font-medium text-gray-500 mb-2">Defense</h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div>
                <p class="text-gray-600">eFG% Allowed</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_effective_fg_percentage_allowed&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_effective_fg_percentage_allowed_rank ? "##{@snapshots.last.adj_effective_fg_percentage_allowed_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">TO% Forced</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_turnover_rate_forced&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_turnover_rate_forced_rank ? "##{@snapshots.last.adj_turnover_rate_forced_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">DReb%</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_defensive_rebound_rate&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_defensive_rebound_rate_rank ? "##{@snapshots.last.adj_defensive_rebound_rate_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">FT Rate Allowed</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_free_throw_rate_allowed&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_free_throw_rate_allowed_rank ? "##{@snapshots.last.adj_free_throw_rate_allowed_rank}" : 'N/A' %></span>
                </p>
              </div>
              <div>
                <p class="text-gray-600">3PT Proficiency Allowed</p>
                <p class="text-lg font-semibold text-prophet-black">
                  <%= @snapshots.last.adj_three_pt_proficiency_allowed&.round(3) || 'N/A' %>
                  <span class="text-xs text-gray-400 ml-1"><%= @snapshots.last.adj_three_pt_proficiency_allowed_rank ? "##{@snapshots.last.adj_three_pt_proficiency_allowed_rank}" : 'N/A' %></span>
                </p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-prophet-black mb-4">Rating Over Time</h2>
      <turbo-frame id="chart">
        <%= render partial: "teams/chart", locals: {
          team: @team,
          chart_data: @chart_data,
          selected_stat: @selected_stat,
          selected_stat_title: @selected_stat_title,
          avg_line: @avg_line,
          upper_line: @upper_line,
          lower_line: @lower_line,
          upper2_line: @upper2_line,
          lower2_line: @lower2_line
        } %>
      </turbo-frame>
    </div>

    <div class="mt-8">
      <h2 class="text-xl font-semibold text-prophet-black mb-4">Season Games</h2>
      <div class="w-full overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Opponent</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Result</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Score</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Prediction</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Correct?</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @team_games.each do |tg| %>
              <% game = tg.game %>
              <% opponent_game = tg.home? ? game.away_team_game : game.home_team_game %>
              <% next unless game %>
              <% opponent = opponent_game&.team %>
              <% opponent_name = opponent&.school || (tg.home? ? game.away_team_name : game.home_team_name) %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to game.start_time.to_date, game_path(game), class: "text-sm text-prophet-black hover:text-blue-600" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= '@ ' unless tg.home? %>
                  <% if opponent %>
                    <%= link_to opponent_name, team_path(opponent.slug), class: "text-sm text-prophet-black hover:text-blue-600" %>
                  <% else %>
                    <%= opponent_name %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-prophet-black">
                  <% if game.completed? && game.home_team_score && game.away_team_score %>
                    <% team_score = tg.home? ? game.home_team_score : game.away_team_score %>
                    <% opponent_score = tg.home? ? game.away_team_score : game.home_team_score %>
                    <%= team_score == opponent_score ? '—' : (team_score > opponent_score ? 'W' : 'L') %>
                  <% else %>
                    <%= game.completed? ? game.status_string : game.status.titleize %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-prophet-black">
                  <%= if game.completed?
                        game.away_team_score && game.home_team_score ? "#{game.away_team_score} - #{game.home_team_score}" : 'N/A'
                      else
                        '-'
                      end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-prophet-black">
                  <% prediction = @predictions_by_game[game.id] %>
                  <% if prediction %>
                    <span class="text-xs text-gray-500"><%= if game.final_unmatched?
                                                               prediction.forecast_kind == 'pregame' ? 'Historical pregame forecast' : "Historical · #{prediction.provenance_label}"
                                                             else
                                                               prediction.provenance_label
                                                             end %></span>
                    <% if prediction.home_score && prediction.away_score %>
                      <%= link_to prediction.predicted_score_string, game_path(game), class: "hover:text-blue-600" %>
                    <% else %>
                      Prediction unavailable
                    <% end %>
                  <% elsif game.final_unmatched? %>
                    Prediction unavailable
                  <% else %>
                    <%= game.current_prediction_unavailable_reason(ratings_config_version: @config)&.humanize || '—' %>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm uppercase">
                  <% if prediction && game.final? && prediction.home_win_probability && game.home_team_score && game.away_team_score %>
                    <% if prediction.correct? %>
                      <span title="Prediction was correct" class="text-green-600">✔</span>
                    <% else %>
                      <span title="Prediction missed" class="text-red-600">✖</span>
                    <% end %>
                  <% else %>
                    -
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
