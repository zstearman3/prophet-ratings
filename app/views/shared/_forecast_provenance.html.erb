<details class="forecast-provenance inline-block align-middle ml-1">
  <summary aria-label="Forecast provenance" aria-describedby="<%= dom_id(prediction, :provenance) %>" class="list-none cursor-pointer rounded px-1 text-sm text-gray-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
    <span aria-hidden="true">ⓘ</span>
  </summary>
  <p id="<%= dom_id(prediction, :provenance) %>" class="w-56 whitespace-normal rounded border border-gray-200 bg-white p-2 text-left text-xs font-normal text-gray-700 shadow"><%= label %></p>
</details>
