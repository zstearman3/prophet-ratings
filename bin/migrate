#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_ROOT"

if [[ $# -gt 0 ]]; then
  echo "Usage: bin/migrate (create/migrate development and update db/schema.rb; no server required)"
  [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]] && exit 0
  exit 1
fi

docker info >/dev/null 2>&1 || { echo "Start Docker Desktop, then retry bin/migrate." >&2; exit 1; }
bin/compose build web
database_running="$(bin/compose ps --status running -q db)"
task_pid=""
run() {
  "$@" &
  task_pid=$!
  wait "$task_pid"
  task_pid=""
}
cleanup() {
  local result=$?
  trap - EXIT INT TERM
  if [[ -n "$task_pid" ]]; then
    kill -TERM "$task_pid" 2>/dev/null || true
  fi
  # Leave an existing development session alone; retain the database and cached image.
  if [[ -z "$database_running" ]]; then
    bin/compose stop db || result=1
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

run bin/compose up -d --wait --wait-timeout 60 db
run bin/compose run --rm --no-deps -T web bin/rails db:create db:migrate
echo "Migrations complete. Review and stage db/schema.rb together with db/migrate changes."
