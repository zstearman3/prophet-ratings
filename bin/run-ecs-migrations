#!/usr/bin/env python3
"""Launch one ECS migration task and fail closed unless it exits successfully."""

import argparse
import json
import subprocess
import sys


def aws(arguments, *, output=False):
    command = ["aws", "ecs", *arguments, "--no-cli-pager"]
    if output:
        command += ["--output", "json"]
    result = subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE if output else None)
    return json.loads(result.stdout) if output else None


def single_task(response):
    tasks = response.get("tasks", [])
    if response.get("failures") or len(tasks) != 1:
        raise ValueError(f"Expected one ECS task without failures: {response}")
    return tasks[0]


def container_names(task):
    names = [container["name"] for container in task.get("containers", [])]
    if not names or any(not name for name in names) or len(names) != len(set(names)):
        raise ValueError("Missing or duplicate migration container names")
    return sorted(names)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for flag in ("cluster", "region", "task-definition", "network-configuration"):
        parser.add_argument(f"--{flag}", required=True)
    options = parser.parse_args()
    scope = ["--cluster", options.cluster, "--region", options.region]
    launched = single_task(aws([
        "run-task", *scope, "--launch-type", "FARGATE", "--count", "1",
        "--task-definition", options.task_definition,
        "--network-configuration", options.network_configuration,
    ], output=True))
    task_arn = launched.get("taskArn")
    if not isinstance(task_arn, str) or not task_arn.startswith("arn:"):
        raise ValueError("Migration launch returned no valid task ARN")
    expected_names = container_names(launched)
    print(f"Waiting for migration task {task_arn}", flush=True)
    task_scope = [*scope, "--tasks", task_arn]
    wait_failed = False
    try:
        aws(["wait", "tasks-stopped", *task_scope])
    except subprocess.CalledProcessError:
        wait_failed = True
        print("Migration waiter failed or timed out; rollout blocked. Task may still be running.", file=sys.stderr)

    # Describe even on waiter failure, so operators can locate and diagnose the task.
    stopped = single_task(aws(["describe-tasks", *task_scope], output=True))
    print(json.dumps({key: stopped.get(key) for key in
                      ("taskArn", "lastStatus", "stopCode", "stoppedReason", "containers")}, indent=2), flush=True)
    if wait_failed:
        raise ValueError("Inspect the migration task before retrying; it has not been stopped automatically")
    if (stopped.get("taskArn") != task_arn or stopped.get("lastStatus") != "STOPPED"
            or stopped.get("stopCode") != "EssentialContainerExited"
            or container_names(stopped) != expected_names):
        raise ValueError("Migration task did not stop normally with the expected containers")
    if any(container.get("lastStatus") != "STOPPED" or type(container.get("exitCode")) is not int
           or container["exitCode"] != 0 for container in stopped["containers"]):
        raise ValueError("Every migration task container must exit successfully (exit code 0)")
    print("Database migrations succeeded; service rollout may proceed.")


if __name__ == "__main__":
    try:
        main()
    except (subprocess.CalledProcessError, ValueError, KeyError, TypeError, OSError) as error:
        print(f"Migration gate failed: {error}", file=sys.stderr)
        sys.exit(1)
