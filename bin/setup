#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'

# path to your application root.
APP_ROOT = File.expand_path('..', __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts '== Installing native hook dependencies =='
  system! 'bundle config set --local without charts'
  system('bundle check') || system!('bundle install')

  puts "\n== Installing hooks and accepting this checkout's hook configuration =="
  system! 'bundle exec overcommit --install'
  system! 'bundle exec overcommit --sign'
  system! 'bundle exec overcommit --sign pre_push'

  puts "\n== Building the shared development/test image =="
  system! 'bin/compose build web'

  puts "\nReady. Run bin/dev to start development, or bin/test to run Docker specs."
end
